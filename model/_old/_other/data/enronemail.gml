graph [
   directed 1
   citation "['B. Klimt and Y. Yang, &quot;The Enron Corpus: A New Dataset for Email Classification Research.&quot; Proc. Eur. Conf. Machine Learning (ECML), 217-226 (2004)., http://snap.stanford.edu/data/email-Enron.html']"
   description "The Enron email corpus, containing all the email communication from the Enron corporation, which was made public as a result of legal action. Nodes are email addresses and node i links to node j if i sent at least one email to address j. Non-Enron email addresses are also present, but only their links to/from Enron addresses are observed."
   name "email_enron"
   tags "Social, Communication, Unweighted, Multigraph, Timestamps"
   url "http://snap.stanford.edu/data/email-Enron.html"
