\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Long-run population metrics by topology (default model; $\tau =1$; time-averaged over the final 500 of 2000 ticks; mean $\pm $ 1 s.d.\ over 10 seeds; homogeneity over 5 seeds). Topologies matched on $\langle k_{\text  {in}}\rangle \approx 4$ and normalised communication rate.}}{3}{table.caption.2}\protected@file@percent }
\newlabel{tab:h1}{{1}{3}{Long-run population metrics by topology (default model; $\tau =1$; time-averaged over the final 500 of 2000 ticks; mean $\pm $ 1 s.d.\ over 10 seeds; homogeneity over 5 seeds). Topologies matched on $\langle k_{\text {in}}\rangle \approx 4$ and normalised communication rate}{table.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Structure does not move the population.} Average (left) and best-agent (right) long-run violations by topology; points are seed means $\pm $ 1 s.d. All four topologies are matched on average in-degree and communication rate.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:h1}{{2}{3}{\textbf {Structure does not move the population.} Average (left) and best-agent (right) long-run violations by topology; points are seed means $\pm $ 1 s.d. All four topologies are matched on average in-degree and communication rate}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Network position sets individual performance along a universal curve}{4}{subsection.2.4}\protected@file@percent }
\newlabel{sec:h2}{{2.4}{4}{Network position sets individual performance along a universal curve}{subsection.2.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Position predicts individual performance in every topology (default model; 10 seeds; mean $\pm $ 1 s.d.). $\rho $: Spearman correlation between in-degree and long-run violations. Gap: mean violations of the 8 most central minus the 8 least central agents (negative = central agents better). Best-agent percentile: centrality percentile of the best performer.}}{4}{table.caption.4}\protected@file@percent }
\newlabel{tab:h2}{{2}{4}{Position predicts individual performance in every topology (default model; 10 seeds; mean $\pm $ 1 s.d.). $\rho $: Spearman correlation between in-degree and long-run violations. Gap: mean violations of the 8 most central minus the 8 least central agents (negative = central agents better). Best-agent percentile: centrality percentile of the best performer}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {One universal position--performance curve.} Per-agent long-run violations versus in-degree, pooled over 10 seeds per topology (bins with $n \geq 5$ agents). All four matched-degree topologies trace the same declining curve; the shaded region marks in-degrees that only the scale-free topology creates.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:curve}{{3}{4}{\textbf {One universal position--performance curve.} Per-agent long-run violations versus in-degree, pooled over 10 seeds per topology (bins with $n \geq 5$ agents). All four matched-degree topologies trace the same declining curve; the shaded region marks in-degrees that only the scale-free topology creates}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Position matters within every network; structure does not matter across them.} Long-run violations versus in-degree for five networks spanning a thirteen-fold range of average degree (natural and designed uniform-degree topologies; default model; $\geq 8$ seeds each; shaded bands $\pm 1$ s.e.m.). Crosses mark each network's population average; the dashed line is the least-squares fit through the crosses (slope $-0.002$, $r=-0.11$).}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:multinet}{{4}{5}{\textbf {Position matters within every network; structure does not matter across them.} Long-run violations versus in-degree for five networks spanning a thirteen-fold range of average degree (natural and designed uniform-degree topologies; default model; $\geq 8$ seeds each; shaded bands $\pm 1$ s.e.m.). Crosses mark each network's population average; the dashed line is the least-squares fit through the crosses (slope $-0.002$, $r=-0.11$)}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Verification is what makes position pay}{5}{subsection.2.5}\protected@file@percent }
\newlabel{sec:whytesting}{{2.5}{5}{Verification is what makes position pay}{subsection.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The position premium requires verification.} Long-run violations versus in-degree with the full model (left) and with verification removed (right; passive observation, same recency communication), on the same networks and seeds. Without verification the curve flattens beyond the first link and the best performer's position is no longer predictable.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:compare}{{5}{5}{\textbf {The position premium requires verification.} Long-run violations versus in-degree with the full model (left) and with verification removed (right; passive observation, same recency communication), on the same networks and seeds. Without verification the curve flattens beyond the first link and the best performer's position is no longer predictable}{figure.caption.7}{}}
