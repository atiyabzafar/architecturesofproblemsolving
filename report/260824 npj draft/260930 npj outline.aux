\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Position and performance (per run, then mean $\pm $ 1 s.d.\ over ten seeds). $\rho $: Spearman correlation between in-degree and long-run violations. Gap: mean violations of the eight agents with the highest in-degree minus the eight with the lowest, so a negative gap means the better connected do better. Last column: mean in-degree percentile of the best performer. The even network has no spread of in-degree.}}{9}{table.4}\protected@file@percent }
\newlabel{tab:position}{{4}{9}{Position and performance (per run, then mean $\pm $ 1 s.d.\ over ten seeds). $\rho $: Spearman correlation between in-degree and long-run violations. Gap: mean violations of the eight agents with the highest in-degree minus the eight with the lowest, so a negative gap means the better connected do better. Last column: mean in-degree percentile of the best performer. The even network has no spread of in-degree}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-agent long-run violations, pooled over ten seeds per network, in bins of at least five agents ($\pm $ 1 s.e.m.). (a) Against in-degree. (b) Against intake $k/\langle k\rangle $ (log scale); the vertical line marks the population-average intake of 1. Solid lines with circles: main set; dashed lines with squares: appendix set. The even network is the single grey point.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:position}{{4}{9}{Per-agent long-run violations, pooled over ten seeds per network, in bins of at least five agents ($\pm $ 1 s.e.m.). (a) Against in-degree. (b) Against intake $k/\langle k\rangle $ (log scale); the vertical line marks the population-average intake of 1. Solid lines with circles: main set; dashed lines with squares: appendix set. The even network is the single grey point}{figure.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.4}Short-run dynamics}{9}{subsubsection.3.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Short-run dynamics, main set, means over ten seeds. (a) Average violations from empty belief stores. (b) Average violations around the shock at period 1500 (dashed line), when every slot of $\mathcal  {C}$ is replaced. (c) Share of agents holding a new clause introduced at the shock, against periods since its introduction, averaged over the new clauses still in $\mathcal  {C}$. (d) Share of agents still believing (solid) and disbelieving (dotted) a clause retired at the shock.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:shortrun}{{5}{10}{Short-run dynamics, main set, means over ten seeds. (a) Average violations from empty belief stores. (b) Average violations around the shock at period 1500 (dashed line), when every slot of $\mathcal {C}$ is replaced. (c) Share of agents holding a new clause introduced at the shock, against periods since its introduction, averaged over the new clauses still in $\mathcal {C}$. (d) Share of agents still believing (solid) and disbelieving (dotted) a clause retired at the shock}{figure.5}{}}
